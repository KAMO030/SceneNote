{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场记"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SceneNote"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SceneNote"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于把你和对方的话实时转成文字与译文；音频默认只在本机处理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたと相手の会話をリアルタイムで文字と訳文にするために使います。音声は既定で端末内でのみ処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나와 상대의 말을 실시간으로 글자와 번역으로 바꾸는 데 사용해요. 오디오는 기본적으로 기기 안에서만 처리돼요."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于把译文私密地播到你的蓝牙耳机，并在耳机断开时立即停止播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訳文を Bluetooth イヤホンにプライベートに再生し、イヤホンが外れたらすぐに再生を止めるために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역을 블루투스 이어폰으로 조용히 재생하고, 이어폰이 끊기면 즉시 재생을 멈추는 데 사용해요."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在同一局域网内把语音流发给装了本 App 的对方设备（不经过任何服务器）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ LAN 内で、このアプリを入れた相手の端末へ音声ストリームを送るために使います（サーバーは経由しません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 LAN 안에서 이 앱을 설치한 상대 기기로 음성 스트림을 보내는 데 사용해요(서버를 거치지 않아요)."
          }
        }
      }
    }
  },
  "version": "1.0"
}
